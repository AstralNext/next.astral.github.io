---
import Base from '../layouts/Base.astro';
import { products } from '../site';

const p = products.game;
---

<Base
  title={`${p.name} · ${p.label}`}
  description="Astral Game：建房、短码进房，开黑联机。"
  currentPath="/game/"
>
  <section class="product-hero">
    <div class="shell">
      <div class="section-head">
        <p class="section-kicker amber">{p.label}</p>
        <picture>
          <source srcset={p.logoDark} media="(prefers-color-scheme: dark)" />
          <img class="product-logo" src={p.logo} alt={`${p.name} logo`} width="300" height="72" data-logo-light={p.logo} data-logo-dark={p.logoDark} />
        </picture>
        <p class="section-lead">建房、短码进房，开黑联机。</p>
        <div class="btn-row" style="margin-top: 0.5rem;">
          <button type="button" class="btn btn-amber" data-open-game-download>{p.downloadLabel}</button>
          <a class="btn btn-ghost" href="/download/#game">全部下载</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="shell">
      <p class="note reveal">
        要自己改配置？请用 <a href={products.general.path}>通用版</a>。
      </p>
    </div>
  </section>
</Base>
