---
import Base from '../layouts/Base.astro';
import ProductShot from '../components/ProductShot.astro';
import { products, site } from '../site';

const p = products.game;
---

<Base
  title={`${p.name} · ${p.label}`}
  description="Astral Game：持续游戏适配，Raft 等。"
  currentPath="/game/"
>
  <section class="product-hero">
    <div class="shell">
      <div class="section-head">
        <p class="section-kicker amber">{p.label}</p>
        <picture>
          <source srcset={p.logoDark} media="(prefers-color-scheme: dark)" />
          <img class="product-logo" src={p.logo} alt={`${p.name} logo`} width="300" height="72" data-logo-light={p.logo} data-logo-dark={p.logoDark} />
        </picture>
        <p class="section-lead">持续游戏适配 · Raft 等</p>
        <div class="btn-row" style="margin-top: 0.5rem;">
          <button type="button" class="btn btn-amber" data-open-game-download>{p.downloadLabel}</button>
          <a class="btn btn-ghost" href="/download/#game">全部下载</a>
          <a class="btn btn-ghost" href={site.docsGame} target="_blank" rel="noopener noreferrer">帮助</a>
          <a class="btn btn-ghost" href={site.docsRaft} target="_blank" rel="noopener noreferrer">Raft 教程</a>
          <a class="btn btn-ghost" href={site.qqChannel} target="_blank" rel="noopener noreferrer">腾讯频道</a>
        </div>
      </div>
      <ProductShot stem="game" alt={`${p.name} 界面`} accent="amber" />
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="shell">
      <p class="note reveal">
        需要自己组网？请用 <a href={products.general.path}>通用版</a>。
      </p>
    </div>
  </section>
</Base>
