---
import Base from '../layouts/Base.astro';
import { products, site } from '../site';
---

<Base
  title="Astral"
  description="Astral：开黑用游戏版，自己组网用通用版。"
  currentPath="/"
>
  <section class="hero">
    <div class="shell wide hero-inner hero-home">
      <div class="hero-copy">
        <h1 class="hero-brand">
          <span>Next</span>
          <span class="hero-brand-word">Astral</span>
        </h1>
        <p class="hero-lead">开黑用游戏版，自己组网用通用版。</p>
        <div class="hero-actions path-grid" role="navigation" aria-label="选择产品">
          <a class="path-link teal" href={products.general.path}>
            <img class="path-mark" src={products.general.mark} alt="" width="40" height="40" />
            <span class="path-kicker">{products.general.label}</span>
            <span class="path-title">{products.general.ctaHome}</span>
            <span class="path-desc">{products.general.blurb}</span>
          </a>
          <a class="path-link amber" href={products.game.path}>
            <img class="path-mark" src={products.game.mark} alt="" width="40" height="40" />
            <span class="path-kicker">{products.game.label}</span>
            <span class="path-title">{products.game.ctaHome}</span>
            <span class="path-desc">{products.game.blurb}</span>
          </a>
        </div>
      </div>

      <div class="hero-stage" aria-hidden="true">
        <figure class="stage-desk back">
          <img src="/shots/game.webp" alt="" width="924" height="507" />
        </figure>
        <figure class="stage-desk front">
          <div class="shot-chrome"><i></i><i></i><i></i></div>
          <img src="/shots/astral.webp" alt="" width="924" height="507" />
        </figure>
        <figure class="stage-phone">
          <img src="/shots/astral-phone.webp" alt="" width="471" height="1024" />
        </figure>
      </div>
    </div>
  </section>

  <section class="section home-pick">
    <div class="shell">
      <div class="section-head reveal">
        <p class="section-kicker teal">Pick</p>
        <h2 class="section-title">先看一眼</h2>
        <p class="section-lead">两个客户端，各干各的事。</p>
      </div>

      <div class="pick-grid reveal">
        <a class="pick-card teal" href={products.general.path}>
          <div class="pick-visual">
            <img class="pick-desk" src="/shots/astral.webp" alt="" width="924" height="507" />
            <img class="pick-phone" src="/shots/astral-phone.webp" alt="" width="471" height="1024" />
          </div>
          <div class="pick-body">
            <span class="pick-kicker">{products.general.label}</span>
            <strong class="pick-title">{products.general.ctaHome}</strong>
            <span class="pick-desc">{products.general.blurb}</span>
          </div>
        </a>
        <a class="pick-card amber" href={products.game.path}>
          <div class="pick-visual">
            <img class="pick-desk" src="/shots/game.webp" alt="" width="924" height="507" />
            <img class="pick-phone" src="/shots/game-phone.webp" alt="" width="409" height="769" />
          </div>
          <div class="pick-body">
            <span class="pick-kicker">{products.game.label}</span>
            <strong class="pick-title">{products.game.ctaHome}</strong>
            <span class="pick-desc">{products.game.blurb}</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section home-next">
    <div class="shell">
      <div class="section-head reveal">
        <p class="section-kicker teal">Next</p>
        <h2 class="section-title">下一步</h2>
        <p class="section-lead">下载安装，或去看文档与源码。</p>
      </div>

      <div class="next-links reveal">
        <a class="next-link" href="/download/">
          <span class="next-link-title">下载</span>
          <span class="next-link-desc">通用版与游戏版</span>
        </a>
        <a class="next-link" href={site.docsLegacy} target="_blank" rel="noopener noreferrer">
          <span class="next-link-title">文档</span>
          <span class="next-link-desc">教程（astral.fan）</span>
        </a>
        <a class="next-link" href={site.githubOrg} target="_blank" rel="noopener noreferrer">
          <span class="next-link-title">GitHub</span>
          <span class="next-link-desc">AstralNext</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section home-et">
    <div class="shell reveal">
      <p class="et-note">
        组网能力基于
        <a href={site.easytier} target="_blank" rel="noopener noreferrer">EasyTier</a>
        。
      </p>
    </div>
  </section>
</Base>

<style is:global>
  .home-et {
    padding-top: 0;
    padding-bottom: 3rem;
  }
  .et-note {
    margin: 0;
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .et-note a {
    color: var(--teal);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
