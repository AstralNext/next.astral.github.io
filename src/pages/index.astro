---
import Base from '../layouts/Base.astro';
import { products, site } from '../site';
---

<Base
  title="Astral"
  description="Astral · Next — 游戏联机与通用组网。"
  currentPath="/"
>
  <section class="hero">
    <div class="shell wide hero-inner hero-home">
      <div class="hero-copy">
        <h1 class="hero-brand">
          <span>Next</span>
          <span class="hero-brand-word">Astral</span>
        </h1>
        <p class="hero-lead" id="hero-hitokoto" data-fallback={site.tagline}>{site.tagline}</p>
        <p class="hero-cite" id="hero-hitokoto-from" hidden></p>
        <div class="hero-actions path-grid" role="navigation" aria-label="选择产品">
          <a class="path-link amber" href={products.game.path}>
            <img class="path-mark" src={products.game.mark} alt="" width="40" height="40" />
            <span class="path-kicker">{products.game.label}</span>
            <span class="path-title">{products.game.ctaHome}</span>
            <span class="path-desc">{products.game.blurb}</span>
          </a>
          <a class="path-link teal" href={products.general.path}>
            <img class="path-mark" src={products.general.mark} alt="" width="40" height="40" />
            <span class="path-kicker">{products.general.label}</span>
            <span class="path-title">{products.general.ctaHome}</span>
            <span class="path-desc">{products.general.blurb}</span>
          </a>
        </div>
      </div>

      <div class="hero-stage" aria-hidden="true">
        <figure class="stage-desk back">
          <img src="/shots/astral.webp" alt="" width="924" height="507" />
        </figure>
        <figure class="stage-desk front">
          <div class="shot-chrome"><i></i><i></i><i></i></div>
          <img src="/shots/game.webp" alt="" width="940" height="553" />
        </figure>
        <figure class="stage-phone">
          <img src="/shots/game-phone.webp" alt="" width="409" height="769" />
        </figure>
      </div>
    </div>
  </section>

  <section class="section home-next">
    <div class="shell">
      <div class="section-head reveal">
        <p class="section-kicker teal">Next</p>
        <h2 class="section-title">下一步</h2>
        <p class="section-lead">下载安装，或去看文档、频道与源码。</p>
      </div>

      <div class="next-links reveal">
        <a class="next-link" href="/download/">
          <span class="next-link-title">下载</span>
          <span class="next-link-desc">通用版与游戏版</span>
        </a>
        <a class="next-link" href={site.docsLegacy} target="_blank" rel="noopener noreferrer">
          <span class="next-link-title">文档</span>
          <span class="next-link-desc">教程（astral.fan）</span>
        </a>
        <a class="next-link" href={site.qqChannel} target="_blank" rel="noopener noreferrer">
          <span class="next-link-title">腾讯频道</span>
          <span class="next-link-desc">【Astral】</span>
        </a>
        <a class="next-link" href={site.githubOrg} target="_blank" rel="noopener noreferrer">
          <span class="next-link-title">GitHub</span>
          <span class="next-link-desc">AstralNext</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section home-et">
    <div class="shell reveal">
      <p class="et-note">
        组网能力基于
        <a href={site.easytier} target="_blank" rel="noopener noreferrer">EasyTier</a>
        。
      </p>
    </div>
  </section>
</Base>

<script>
  const lead = document.getElementById('hero-hitokoto');
  const cite = document.getElementById('hero-hitokoto-from');
  if (lead) {
    const fallback = lead.dataset.fallback?.trim() || lead.textContent?.trim() || '';
    const apply = (text: string, from = '') => {
      lead.textContent = text;
      if (cite instanceof HTMLElement) {
        if (from) {
          cite.textContent = `— ${from}`;
          cite.hidden = false;
        } else {
          cite.textContent = '';
          cite.hidden = true;
        }
      }
    };
    try {
      const res = await fetch('https://v1.hitokoto.cn/?c=a', {
        signal: AbortSignal.timeout(4500),
      });
      if (!res.ok) throw new Error(`hitokoto ${res.status}`);
      const data = (await res.json()) as {
        hitokoto?: string;
        from?: string;
        from_who?: string | null;
      };
      const text = String(data.hitokoto ?? '').trim();
      if (!text) throw new Error('empty hitokoto');
      const from = [data.from_who, data.from].filter(Boolean).join(' · ');
      apply(text, from);
    } catch {
      apply(fallback);
    }
  }
</script>

<style is:global>
  .home-et {
    padding-top: 0;
    padding-bottom: 3rem;
  }
  .et-note {
    margin: 0;
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .et-note a {
    color: var(--teal);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .hero-cite {
    margin: -0.7rem 0 0;
    max-width: 28rem;
    font-size: 0.88rem;
    color: var(--muted);
    font-style: normal;
    opacity: 0;
    animation: rise 0.9s var(--ease) 0.28s forwards;
  }
</style>
